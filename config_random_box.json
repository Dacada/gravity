{
    "core": {
        "target_framerate": 60
    },
    "layout": {
        "width": 700,
        "height": 500,
        "inspector_ratio": { "ratio": "2/7" },
        "pause_icon": {
            "offset_ratio": [ { "ratio": "5%" }, { "ratio": "5%" } ],
            "size": [ 40, 50 ],
            "anchor": "TOP_LEFT"
        },
        "camera_state_icon" : {
            "offset_ratio": [ { "ratio": "2%" }, { "ratio": "98%" } ],
            "size": [ 50, 50 ],
            "anchor": "BOTTOM_LEFT"
        }
    },
    "simulation": {
        "control": {
            "physics_timedelta": { "ratio": "1/500" },
            "physics_step_alloted_time_clamp": 0.25,
            "time_scale": 1
        },
        "model": {
            "default_simulated_entity_color": [255, 255, 255]
        },
        "physics": {
            "gravitational_constant": 100.0,
            "softening_factor": 0.5,
            "enable_merging": true,
            "merge_distance_squared": 1
        },
        "initial_conditions": {
            "seed": null,
            "root": {
                "entities": [
                    {
                        "entity": {
                            "type": "cloud",
                            "count": 256,
                            "region": {
                                "shape": "box",
                                "disorder": 1.5,
                                "width": 500,
                                "height": 500
                            },
                            "mass": {
                                "type": "gaussian-absolute",
                                "mean": 5,
                                "sigma": 10
                            },
                            "velocity": [
                                {
                                    "type": "uniform",
                                    "start": -10,
                                    "end": 10
                                },
                                {
                                    "type": "uniform",
                                    "start": -10,
                                    "end": 10
                                }
                            ]
                        },
                        "position": [
                            {
                                "type": "literal",
                                "value": 0
                            },
                            {
                                "type": "literal",
                                "value": 0
                            }
                        ],
                        "velocity": [
                            {
                                "type": "literal",
                                "value": 0
                            },
                            {
                                "type": "literal",
                                "value": 0
                            }
                        ]
                    }
                ]
            }
        }
    },
    "ui": {
        "format": {
            "position_format": ".3f",
            "velocity_format": ".3f",
            "mass_format": ".3f"
        },
        "cursor": {
            "viewport_clickable_margin": 5,
            "selection_distance_squared": 20
        },
        "pause_animation": {
            "speed": 2.5
        }
    },
    "camera": {
        "pan_speed": 100.0,
        "zoom_factor": 1.5
    },
    "render": {
        "styles": {
            "pause_icon": {
                "color": [255, 255, 255],
                "bar_width": 10,
                "bar_height": 50,
                "gap": 8
            },
            "target_icon": {
                "color": [255, 255, 255],
                "size": 48,
                "center_radius": 6,
                "corner_length": 14,
                "corner_thickness": 3
            },
            "com_icon": {
                "color": [255, 255, 255],
                "center_radius": 12,
                "center_thickness": 3,
                "dot_radius": 3,
                "dot_distance": 20,
                "dot_count": 6
            },
            "freecam_icon": {
                "color": [255, 255, 255],
                "tri_size": 7,
                "circle_radius": 7,
                "line_width": 2
            },
            "inspector": {
                "bg_color": [30, 30, 30],
                "border_color": [80, 80, 80],
                "text_color": [255, 255, 255],
                "padding": [20, 50],
                "control_separation": 15
            },
            "simulated_entity": {
                "radius": 4,
                "reticle_padding": 3,
                "reticle_width": 2,
                "reticle_color": [255, 255, 255]
            },
            "name": {
                "diagonal_length": 20,
                "horizontal_length": 40
            }
        },
        "font_name": "notosansmono",
        "font_size": 12
    }
}
